pipeline {
    agent any

    environment {
        APP_NAME  = 'calculator-app'
        VERSION   = '1.0.0'
    }

    stages {

        stage('Checkout') {
            steps {
                echo "=== Pulling code from GitHub ==="
                checkout scm
                echo "Code checked out successfully!"
            }
        }

        stage('Build') {
            steps {
                echo "=== Building ${APP_NAME} v${VERSION} ==="
                sh '''
                    cd Jenkins-project03
                    python3 --version
                    ls -la
                    python3 calculator.py
                '''
            }
        }

        stage('Test') {
            steps {
                echo "=== Running Unit Tests ==="
                sh 'cd Jenkins-project03 && python3 -m pytest test_calculator.py -v'
            }
        }

        stage('Deploy') {
            steps {
                echo "=== Deploying ${APP_NAME} ==="
                sh '''
                    echo "Deployment simulation..."
                    echo "App: $APP_NAME"
                    echo "Version: $VERSION"
                    echo "Build: $BUILD_NUMBER"
                    echo "Deployed successfully!"
                '''
            }
        }
    }

    post {

        success {
            echo "✅ PIPELINE PASSED — All stages completed!"

            emailext(
                subject: "✅ SUCCESS: ${JOB_NAME} #${BUILD_NUMBER}",
                body: """
                    Build Status : SUCCESS
                    Job Name     : ${JOB_NAME}
                    Build Number : ${BUILD_NUMBER}
                    Build URL    : ${BUILD_URL}
                """,
                to: 'anchitashukla.in@gmail.com'
            )
        }

        failure {
            echo "❌ PIPELINE FAILED — Check the logs above."

            emailext(
                subject: "❌ FAILED: ${JOB_NAME} #${BUILD_NUMBER}",
                body: """
                    Build Status : FAILED
                    Job Name     : ${JOB_NAME}
                    Build Number : ${BUILD_NUMBER}
                    Build URL    : ${BUILD_URL}

                    Please check console output.
                """,
                to: 'anchitashukla.in@gmail.com'
            )
        }

        always {
            echo "Pipeline finished. Build #$BUILD_NUMBER done."
        }
    }
}
