pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'production'],
            description: 'Which environment to deploy to?'
        )
        string(
            name: 'VERSION',
            defaultValue: '1.0.0',
            description: 'App version to deploy'
        )
        booleanParam(
            name: 'RUN_TESTS',
            defaultValue: true,
            description: 'Run tests before deploying?'
        )
    }

    stages {

        stage('Show Parameters') {
            steps {
                echo "Environment : ${params.ENVIRONMENT}"
                echo "Version     : ${params.VERSION}"
                echo "Run Tests   : ${params.RUN_TESTS}"
            }
        }

        stage('Test') {
            when {
                expression { return params.RUN_TESTS == true }
            }
            steps {
                echo "Running tests for v${params.VERSION}..."
                sh 'echo "All tests passed!"'
            }
        }

        stage('Deploy') {
            when {
                expression { return params.ENVIRONMENT != 'production' }
            }
            steps {
                echo "Deploying v${params.VERSION} to ${params.ENVIRONMENT}..."
                sh """
                    echo "=== DEPLOYMENT ==="
                    echo "Target : ${params.ENVIRONMENT}"
                    echo "Version: ${params.VERSION}"
                    echo "Deploy complete!"
                """
            }
        }

        stage('Production Approval') {
            when {
                expression { return params.ENVIRONMENT == 'production' }
            }
            steps {
                echo "⚠️ Production deploy requested!"
                echo "Simulating approval gate..."
                sh 'echo "Production deployment approved!"'
            }
        }

    }

    post {
        success {
            echo "✅ PIPELINE PASSED!"
            emailext(
                subject: "✅ SUCCESS: ${JOB_NAME} #${BUILD_NUMBER}",
                body: """
                    Build Status  : SUCCESS
                    Environment   : ${params.ENVIRONMENT}
                    Version       : ${params.VERSION}
                    Build URL     : ${BUILD_URL}
                """,
                to: 'anchitashukla.in@gmail.com'
            )
        }
        failure {
            echo "❌ PIPELINE FAILED!"
            emailext(
                subject: "❌ FAILED: ${JOB_NAME} #${BUILD_NUMBER}",
                body: """
                    Build Status  : FAILED
                    Environment   : ${params.ENVIRONMENT}
                    Version       : ${params.VERSION}
                    Build URL     : ${BUILD_URL}
                """,
                to: 'anchitashukla.in@gmail.com'
            )
        }
        always {
            echo "Pipeline finished. Build #${BUILD_NUMBER} done."
        }
    }

}
